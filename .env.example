# SIQVA Environment Configuration Example
# Copy to .env and configure as needed

# LLM Backend: openai_compatible | ollama | none (default: none if unset or missing credentials)
SIQVA_LLM_BACKEND=none

# Hosted OpenAI-compatible LLM endpoint
SIQVA_LLM_BASE_URL=
SIQVA_LLM_MODEL=
SIQVA_LLM_API_KEY=
SIQVA_LLM_JSON_MODE=json_object
SIQVA_LLM_DAILY_CAP=500

# Optional Ollama local LLM endpoint (when SIQVA_LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Test environment flags (0 = skipped, 1 = run)
RUN_NETWORK_TESTS=0
RUN_OLLAMA_TESTS=0

